# LiveKit credentials — NEVER commit the real .env.
# NOTE: the previous key/secret were committed to git history and must be
# rotated in the LiveKit Cloud dashboard before live testing.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_ROOM=soulx-flashhead-room

# Model selection
SOULX_MODEL_TYPE=pro                # pro = full quality, lite = LTX fast path
SOULX_CKPT_DIR=models/SoulX-FlashHead-1_3B
SOULX_WAV2VEC_DIR=models/wav2vec2-base-960h
SOULX_COND_IMAGE=examples/omani_character.png

# Latency profile: lowlat (160ms chunks) | balanced (320ms) | default (1120ms)
FLASH_HEAD_PROFILE=lowlat

# Conversational bot (soulx_conversational_bot.py) — the interruptible agent.
# webrtc_sync.py (echo-back) does NOT need these.
DEEPGRAM_API_KEY=your_deepgram_key
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional overrides
# FLASH_HEAD_ATTN=auto              # fa3 | sage | fa2 | sdpa
# FLASH_HEAD_FUSED_KERNELS=1        # 0 disables YEP-48 Triton kernels
# FLASH_HEAD_STEPS=4               # 2 = faster/lower-quality denoise
